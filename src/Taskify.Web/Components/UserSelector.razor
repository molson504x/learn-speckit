@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Taskify.ServiceDefaults.ReferenceData
@inject ProtectedSessionStorage SessionStorage

<label class="form-label" for="user-selector">Active user</label>
<select id="user-selector" class="form-select" value="@SelectedUserId" @onchange="HandleSelectionChanged">
    <option value="">Choose a predefined user</option>
    @foreach (var user in PredefinedUsers.All)
    {
        <option value="@user.Id">@user.Name (@user.Role)</option>
    }
</select>

@code {
    private const string StorageKey = "taskify.active-user";

    [Parameter]
    public Guid? SelectedUserId { get; set; }

    [Parameter]
    public EventCallback<Guid?> SelectedUserIdChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (SelectedUserId is not null)
        {
            return;
        }

        var storedUser = await SessionStorage.GetAsync<Guid?>(StorageKey);
        if (storedUser.Success)
        {
            SelectedUserId = storedUser.Value;
        }
    }

    private async Task HandleSelectionChanged(ChangeEventArgs args)
    {
        Guid? selectedUserId = null;
        if (Guid.TryParse(args.Value?.ToString(), out var parsedUserId))
        {
            selectedUserId = parsedUserId;
        }

        SelectedUserId = selectedUserId;
        if (selectedUserId is null)
        {
            await SessionStorage.DeleteAsync(StorageKey);
        }
        else
        {
            await SessionStorage.SetAsync(StorageKey, selectedUserId.Value);
        }
        await SelectedUserIdChanged.InvokeAsync(selectedUserId);
    }
}
